localizedName: Gray Planet
description: A cold, mist-shrouded gray planet. It features rocky shorelines, expansive sand banks, stone peaks, and full access to advanced Erekir logistics.

# Celestial Rules
parent: sun
solarSystem: sun
radius: 1.2
accessible: true
hasAtmosphere: true
atmosphereColor: 8c8c8c
iconColor: 6b6b6b
updateLighting: true

# Visual Core Palette (Matte Grays)
sphereColor: 4f4f4f
landCloudColor: b3b3b3

# Cloud Layers
cloudMesh: {
  type: HexSkyMesh
  planet: gray-planet
  seed: 99
  speed: 0.6
  radius: 0.15
  divisions: 4
  color: cce6e6aa
}

# Weather Systems
weather: [
  {
    type: RainWeather
    duration: 3600
    chance: 0.35
  }
]

# Tech-Tree Alignment (Enforces Erekir units, blocks, and extraction tools)
techTree: erekir
allowLaunchToNumbered: true
allowLaunchSchematics: false

# Auto Map Generator Constraints (Bounded tightly at 128)
generator: {
  type: PlanetGenerator
  minSize: 128
  maxSize: 128
  
  # Structural Resource Layout (Forces Erekir-exclusive ores to drop
  thoriumScale: 0.0
  copperScale: 0.0
  leadScale: 0.0
  coalScale: 0.0

  # Ground Palette (Injects vanilla Erekir stone, sand variations, water, and beaches)
  defaultFloors: [ ferric-stone, dacite, carbon-stone ]
  sandFloors: [ regular-sand, sand ]
  baseFloors: [ stone, stone-wall ]
  liquidFloors: [ water, dacite-water ]
  beachFloors: [ sand-water, shallow-water ]
  
  # Environmental Features (Populates natural Erekir rock props, boulders, and vents)
  decorations: [ dacite-boulder, ferric-boulder ]
}
