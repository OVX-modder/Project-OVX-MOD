type: ConsumeGenerator
name: Steam Turbine
description: Uses pumped steam to create energy.
size: 2
category: power
requirements: [
  copper/60
  lead/50
  metaglass/30
  stainless-steel/40
]

consumes: {
  liquid: {
    liquid: steam
    amount: 0.25
  }
}

liquidCapacity: 450
powerProduction: 5
itemDuration: 800
generateEffect: generatespark
warmupSpeed: 0.003333
research: {
  parent: kiln
  objectives: [
    metaglass
    stainless-steel
  ]
  requirements: [
    copper/6000
    lead/10000
    metaglass/3000
    stainless-steel/2000
  ]
}

drawer: {
  type: DrawMulti
  drawers: [
    {
      type: DrawRegion
      suffix: -base
    }
    {
      type: DrawRegion
      suffix: -spin
      spinSprite: true
      rotateSpeed: 20
    }
    {
      type: DrawRegion
      suffix: -cover
    }
  ]
}
